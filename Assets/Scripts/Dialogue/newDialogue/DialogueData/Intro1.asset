%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 268aebd63db5fae47a7ca85068e7186c, type: 3}
  m_Name: Intro1
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: Wha.. what am I doing here?
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 6714f47356712264b978e611b6cb7da0,
      type: 3}
  - text: And.. Who am I?
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 6714f47356712264b978e611b6cb7da0,
      type: 3}
  - text: 'Are these.. handcuffs? Is this a prison? '
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 6714f47356712264b978e611b6cb7da0,
      type: 3}
  - text: It's useless..... I can't remember anything..
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 6714f47356712264b978e611b6cb7da0,
      type: 3}
  - text: This place... It looks like I am underground
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 6714f47356712264b978e611b6cb7da0,
      type: 3}
  - text: It doesn't look like a very cozy place to stay.. I guess this dagger will
      help..
    characterName: 
    characterPortrait: {fileID: 21300000, guid: fff17a327adfdb243a219d65e330589c,
      type: 3}
  - text: I think I can use this dagger to make my way to the exit.. At least for
      now..
    characterName: 
    characterPortrait: {fileID: 21300000, guid: fff17a327adfdb243a219d65e330589c,
      type: 3}
  - text: Maybe I can find something useful for myself later..
    characterName: 
    characterPortrait: {fileID: 21300000, guid: fff17a327adfdb243a219d65e330589c,
      type: 3}
  - text: Damn.. I wouldn't mind some good sword or bow.. It would make much easier
      to go through this place
    characterName: 
    characterPortrait: {fileID: 21300000, guid: fff17a327adfdb243a219d65e330589c,
      type: 3}
  - text: My body feels rusty.. These rats and spiders will make a good warm up for
      me..
    characterName: 
    characterPortrait: {fileID: 21300000, guid: fff17a327adfdb243a219d65e330589c,
      type: 3}
  - text: .. Let's go
    characterName: 
    characterPortrait: {fileID: 21300000, guid: fff17a327adfdb243a219d65e330589c,
      type: 3}
  ghostName: 
  defaultPersonPortrait: {fileID: 0}
