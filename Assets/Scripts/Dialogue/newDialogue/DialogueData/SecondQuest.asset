  m_Script: {fileID: 11500000, guid: 268aebd63db5fae47a7ca85068e7186c, type: 3}
  m_Name: SecondQuest
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: I guess I will take some break for now..
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 3704a827161e60c40818dafd533a5d37,
      type: 3}
  - text: I feel like my body is finally warming up.. I feel my strength coming back
      to me.. And I also found a weapon..
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 3704a827161e60c40818dafd533a5d37,
      type: 3}
  - text: Still so many questions.. Why am I even entrapped here?
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 5362f18b0604fc147a727e9c4f0b5257,
      type: 3}
  - text: But with progress like this I hope that I will be out of this undegrounds
      in no time..
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 5362f18b0604fc147a727e9c4f0b5257,
      type: 3}
  - text: I should be careful tho.. I still don't know what can be hiding later on..
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 5362f18b0604fc147a727e9c4f0b5257,
      type: 3}
  ghostName: 
  defaultPersonPortrait: {fileID: 0}
